# The same style Prettier enforces in apps/web, stated once for every editor
# and for the files Prettier does not read — C#, YAML, nginx, shell.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.cs]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{sh,conf,conf.example}]
indent_style = tab
