# Copy to `.env` beside the compose file and fill both secrets in.
#
#     cp .env.example .env
#
# `.env` is git-ignored. Neither secret has a default: compose refuses to start
# without them rather than booting something that looks fine and is not.

# Postgres. Read once, at first start, when the volume is created — changing it
# afterwards does not change the password the database already has.
#
#     openssl rand -base64 32
POSTGRES_PASSWORD=

# The code a device types once, in Nastavení → Párování, to be handed a
# token. It is not a password, and it is the only thing standing between
# somebody and your board.
#
# Digits only. The field asks the phone for a numeric keypad, so a code with
# letters in it is one you cannot type on the device that has to type it.
#
# Twelve of them, and the leading one is never zero. A device pairs once in its
# life, so the length is free — and it is the only defence here that does not
# depend on a fence holding. The server also caps the endpoint as a whole at
# twenty attempts an hour, from everywhere.
#
#     shuf --random-source=/dev/urandom -i 100000000000-999999999999 -n 1
PAIRING_CODE=

# Where the app answers on the host, for the host's nginx to proxy to. Prosper
# has 8080 on the same VPS, so this one is 8081. Bound to 127.0.0.1 either way.
ASPIRE_PORT=8081
